{
  "name": "@pingboard/mcp",
  "version": "0.2.0",
  "private": false,
  "description": "MCP server for PingBoard — query and control your uptime monitors from Claude, Cursor, or any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pingboard-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
